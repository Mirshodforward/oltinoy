{
  "name": "oltinoy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "build:bot": "tsup",
    "start": "next start -p 11000",
    "start:bot": "node dist/bot/index.js",
    "dev:bot": "tsx watch src/bot/index.ts",
    "bot:webhook": "node --env-file=.env scripts/set-webhook.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "gen:assets": "node scripts/gen-assets.mjs",
    "admin:password": "node --env-file=.env scripts/set-admin-password.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/manrope": "^5.2.8",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "grammy": "^1.44.0",
    "marked": "^18.0.5",
    "next": "15.5.20",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
