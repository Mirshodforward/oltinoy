generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  SOLD_OUT
  HIDDEN
}

enum BookingStatus {
  NEW
  CONFIRMED
  CONTACTED
  CANCELLED
  COMPLETED
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  nameUz    String
  nameRu    String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
}

model Product {
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  sku           String?        @unique
  nameUz        String
  nameRu        String
  descriptionUz String?        @db.Text
  descriptionRu String?        @db.Text
  materialUz    String?
  materialRu    String?
  price         Int
  oldPrice      Int?
  sizes         String[]
  minOrderQty   Int            @default(1)
  status        ProductStatus  @default(ACTIVE)
  isNew         Boolean        @default(true)
  viewCount     Int            @default(0)
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  bookings      Booking[]
  tgMessageIds  Int[]          @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, categoryId, createdAt])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName  String
  width     Int
  height    Int
  sortOrder Int     @default(0)
  altUz     String?
  altRu     String?
}

model Booking {
  id               Int           @id @default(autoincrement())
  productId        Int
  product          Product       @relation(fields: [productId], references: [id])
  size             String
  quantity         Int           @default(1)
  customerName     String
  phone            String
  tgUsername       String?
  note             String?
  status           BookingStatus @default(NEW)
  adminNote        String?
  adminTgMessageId Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Subscriber {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  firstName  String?
  username   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Post {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  titleUz     String
  titleRu     String
  excerptUz   String?
  excerptRu   String?
  contentUz   String    @db.Text
  contentRu   String    @db.Text
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Setting {
  key   String @id
  value String @db.Text
}

// ───────────────────────────── Analitika ─────────────────────────────
// Birinchi tomon (self-hosted) analitika: tashqi servis yo'q, cookie yo'q,
// ma'lumot shu bazadan chiqmaydi. Sessiya GA bilan bir xil qoidada —
// 30 daqiqa harakatsizlikdan keyin yangisi boshlanadi.

model AnalyticsSession {
  id          String   @id // mijoz tomonda yaratilgan uuid
  visitorId   String // barqaror tashrifchi id (localStorage)
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  durationSec Int      @default(0)
  pageviews   Int      @default(0)
  eventCount  Int      @default(0)

  landingPath String
  exitPath    String?

  // Qayerdan kelgan
  referrer    String?
  refHost     String?
  refType     String  @default("direct") // direct|search|social|telegram|referral
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Kim
  country    String?
  device     String  @default("desktop") // mobile|tablet|desktop
  os         String?
  browser    String?
  screenW    Int?
  locale     String?
  isTelegram Boolean @default(false)

  events AnalyticsEvent[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId, startedAt])
  @@index([refType, startedAt])
}

model AnalyticsEvent {
  id        Int              @id @default(autoincrement())
  sessionId String
  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      String // pageview|click|custom
  name      String // pageview -> sahifa sarlavhasi; click -> tugma yorlig'i
  path      String
  productId Int?
  meta      Json?
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([path, createdAt])
  @@index([kind, name, createdAt])
  @@index([sessionId])
}
